<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    tools:context=".MainActivity">

    <!-- Top Bar: Botão Sobre e Seletor de Idioma -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:paddingHorizontal="16dp">

        <ImageButton
            android:id="@+id/aboutButton"
            style="@style/caixa_linguagem"
            android:layout_alignParentStart="true"
            android:src="@android:drawable/ic_menu_info_details"
            android:contentDescription="@string/about_button_desc"
            app:tint="@color/white" />

        <ImageButton
            android:id="@+id/logoutButton"
            style="@style/caixa_linguagem"
            android:layout_toEndOf="@id/aboutButton"
            android:layout_marginStart="8dp"
            android:src="@android:drawable/ic_lock_power_off"
            android:contentDescription="@string/logout"
            app:tint="@color/white" />

        <TextView
            android:id="@+id/languageBox"
            style="@style/caixa_linguagem"
            android:layout_toStartOf="@id/themeButton"
            android:layout_marginEnd="8dp"
            android:text="@string/lang_tag" />

        <ImageButton
            android:id="@+id/themeButton"
            style="@style/caixa_linguagem"
            android:layout_alignParentEnd="true"
            android:src="@android:drawable/ic_menu_compass"
            android:contentDescription="@string/theme_button_desc"
            app:tint="@color/white" />
    </RelativeLayout>

    <!-- Conteúdo Central -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/appTitle"
            style="@style/titulo_app"
            android:text="@string/app_name" />

        <TextView
            android:id="@+id/appSubtitle"
            style="@style/subtitulo_app"
            android:text="@string/subtitle_app" />

        <Button
            android:id="@+id/startButton"
            style="@style/botao_principal"
            android:background="@drawable/button_ripple"
            android:text="@string/start_button"
            android:layout_marginBottom="16dp"
            app:backgroundTint="@null" />

        <Button
            android:id="@+id/historyButton"
            style="@style/botao_principal"
            android:background="@drawable/button_ripple"
            android:text="@string/ver_historico"
            android:alpha="0.85"
            android:layout_marginBottom="16dp"
            app:backgroundTint="@null" />

        <Button
            android:id="@+id/exploreButton"
            style="@style/botao_principal"
            android:background="@drawable/button_ripple"
            android:text="@string/explore_button"
            android:alpha="0.8"
            app:backgroundTint="@null" />

    </LinearLayout>
</FrameLayout>
